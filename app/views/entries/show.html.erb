<div class="page-heading"><div><div class="eyebrow">DETALHES DO LANÇAMENTO</div><h1><%= @entry.description %></h1></div><%= link_to 'Editar lançamento', edit_entry_path(@entry), class: 'button' %></div>
<section class="panel form-panel"><strong class="detail-amount"><%= brl(@entry.amount) %></strong><dl class="detail-grid"><dt>Data</dt><dd><%= l(@entry.date) %></dd><dt>Categoria</dt><dd><%= @entry.category.name %></dd><dt>Tipo</dt><dd><%= Entry::KINDS[@entry.kind] %></dd><dt>Situação</dt><dd><%= Entry::STATUSES[@entry.status] %></dd><dt>Pagamento</dt><dd><%= @entry.payment_method.presence || 'Não informado' %></dd><dt>Observações</dt><dd><%= @entry.notes.presence || 'Nenhuma' %></dd></dl>
<% if @entry.installment_group %><p class="form-help">Parcela <%= @entry.installment_number %> de <%= @entry.installments_count %>. Edição e exclusão afetam somente esta parcela.</p><% end %>
<div class="form-actions"><%= link_to 'Voltar', entries_path(year: @entry.financial_year.year), class: 'button secondary' %><%= button_to 'Excluir lançamento', entry_path(@entry), method: :delete, class: 'button danger', data: { turbo_confirm: 'Excluir este lançamento? Esta ação não pode ser desfeita.' } %></div></section>
