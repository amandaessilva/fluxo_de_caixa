<% content_for :title, 'Visão anual' %><div class="page-heading"><div><div class="eyebrow">O ANO INTEIRO, COM CLAREZA</div><h1>Visão anual<span class="gold">.</span></h1><p class="muted">Doze meses para construir seus próximos passos.</p></div></div>
<%= render 'shared/period', url: annual_path, annual: true %>
<% @reports.each do |status, reports| %><section class="panel annual-panel"><div class="section-heading"><h2><%= Entry::STATUSES[status] %> · <%= selected_year.year %></h2><span class="badge <%= status %>">Valores separados</span></div>
<div class="table-scroll"><table><thead><tr><th>Mês</th><th class="numeric">Saldo inicial</th><% Entry::KINDS.each_value do |label| %><th class="numeric"><%= label %></th><% end %><th class="numeric">Variação</th><th class="numeric">Saldo final</th></tr></thead><tbody>
<% reports.each do |report| %><tr><th><%= link_to month_name(report.month).capitalize, root_path(year: selected_year.year, month: report.month, status: status) %></th><td class="numeric"><%= brl(report.opening_balance) %></td><% Entry::KINDS.each_key do |kind| %><td class="numeric"><%= brl(report.total(kind)) %></td><% end %><td class="numeric"><%= brl(report.variation) %></td><td class="numeric amount"><%= brl(report.closing_balance) %></td></tr><% end %>
</tbody><tfoot><% total = BalanceReport.new(selected_year, status: status) %><tr><th>Total anual</th><td class="numeric"><%= brl(total.opening_balance) %></td><% Entry::KINDS.each_key do |kind| %><td class="numeric"><%= brl(total.total(kind)) %></td><% end %><td class="numeric"><%= brl(total.variation) %></td><td class="numeric"><%= brl(total.closing_balance) %></td></tr></tfoot></table></div></section><% end %>
<p class="muted small">Saldos não são somados: a linha anual mostra o saldo inicial de janeiro e o saldo final de dezembro.</p>
