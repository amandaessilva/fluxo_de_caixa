<% content_for :title, 'Visão geral' %>
<div class="page-heading"><div><div class="eyebrow">CADA ESCOLHA CONTA</div><h1>Seu dinheiro, em perspectiva<span class="gold">.</span></h1><p class="muted">Acompanhe o mês e dê espaço aos seus planos.</p></div><%= link_to '+ Novo lançamento', new_entry_path(year: selected_year.year, month: selected_month), class: 'button' %></div>
<div class="period-bar"><div class="month-heading"><span class="calendar-icon">▦</span><div><h2><%= month_name(selected_month).capitalize %> <%= selected_year.year %></h2><span class="muted small">Valores <%= selected_status == 'actual' ? 'realizados' : 'planejados' %></span></div></div><%= render 'shared/period', url: root_path %></div>
<section class="balance-grid" aria-label="Resumo do saldo">
  <article class="balance-card"><div class="overline">SALDO FINAL DO MÊS <span>↗</span></div><strong class="hero-amount"><%= brl(@report.closing_balance) %></strong><p>Seu saldo após todas as movimentações</p><div class="balance-bottom"><span>Variação no mês</span><strong><%= brl(@report.variation) %></strong></div></article>
  <article class="stat-card"><span class="stat-icon">↳</span><div class="overline">SALDO INICIAL</div><strong><%= brl(@report.opening_balance) %></strong><p class="muted small">O ponto de partida deste mês</p></article>
  <article class="stat-card"><span class="stat-icon gold-bg">≈</span><div class="overline">DESPESAS + BENEFÍCIOS USADOS</div><strong><%= brl(@report.total('expense') + @report.total('benefit_used')) %></strong><p class="muted small">Tudo que saiu no período</p></article>
</section>
<section class="metrics" aria-label="Movimentações por tipo">
<% [['income', '↙'], ['benefit_received', '◇'], ['expense', '↗'], ['benefit_used', '◈']].each do |kind, icon| %><article><span class="metric-symbol"><%= icon %></span><div><span class="muted small"><%= Entry::KINDS[kind] %></span><strong><%= brl(@report.total(kind)) %></strong></div></article><% end %>
</section>
<div class="dashboard-bottom"><section class="panel"><div class="section-heading"><div><h2>Lançamentos do mês</h2><p class="muted small"><%= @entries.size %> movimentações · <%= Entry::STATUSES[selected_status] %></p></div><%= link_to 'Ver todos →', entries_path(year: selected_year.year, month: selected_month, status: selected_status), class: 'text-link' %></div><%= render 'shared/entries', entries: @entries.first(8) %></section>
<section class="panel limits-panel"><div class="section-heading"><div><h2>De olho nos limites</h2><p class="muted small">Despesas e benefícios utilizados</p></div></div>
<% if @limits.any? %><% spending = @report.spending_by_category %><% @limits.each do |limit| %><% spent = spending.fetch(limit.category_id, 0) %><div class="limit-row"><div><strong><%= limit.category.name %></strong><span class="<%= 'negative' if spent > limit.amount %>"><%= brl(spent) %></span></div><progress value="<%= percent(spent, limit.amount) %>" max="100" aria-label="Limite de <%= limit.category.name %>"></progress><p class="muted small">Limite <%= brl(limit.amount) %><%= ' · Acima do limite' if spent > limit.amount %></p></div><% end %><% else %><div class="empty compact"><p>Defina limites por categoria para acompanhar seus gastos.</p></div><% end %>
<%= link_to 'Gerenciar categorias →', categories_path, class: 'text-link' %></section></div>
<div class="insight"><span>✦</span><p><strong>Planejar é cuidar do que importa.</strong> Compare o planejado e o realizado para ajustar o próximo mês.</p><%= link_to 'Explorar o ano →', annual_path, class: 'text-link' %></div>
