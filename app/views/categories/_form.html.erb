<%= render 'shared/errors', record: @category %><%= form_with model: @category, class: 'panel form-panel' do |f| %>
<div><%= f.label :name, 'Nome da categoria' %><%= f.text_field :name, required: true, maxlength: 100 %></div><h2 class="spaced">Limites mensais · <%= selected_year.year %></h2><p class="muted">Deixe vazio para manter o limite atual. Zero significa nenhum orçamento para o mês.</p>
<div class="form-grid three-cols"><% (1..12).each do |month| %><% amount = selected_year.monthly_limits.find_by(category: @category, month: month)&.amount %><div><%= label_tag "limits_#{month}", month_name(month).capitalize %><%= text_field_tag "limits[#{month}]", params.dig(:limits, month.to_s) || (amount && number_with_precision(amount, precision: 2, separator: ',')), id: "limits_#{month}", inputmode: 'decimal', placeholder: 'Sem limite' %></div><% end %></div><div class="form-actions"><%= f.submit 'Salvar categoria', class: 'button' %><%= link_to 'Cancelar', categories_path, class: 'button secondary' %></div><% end %>
