<div class="page-heading"><h1>Revisar restauração<span class="gold">.</span></h1></div><section class="panel form-panel"><h2>Conteúdo do backup</h2><ul><% { 'financial_years' => 'Anos', 'categories' => 'Categorias', 'entries' => 'Lançamentos', 'monthly_limits' => 'Limites', 'recurring_rules' => 'Contas fixas' }.each do |key, label| %><li><%= label %>: <%= @data['data'][key].size %></li><% end %></ul><p class="form-help">Todos os dados financeiros serão substituídos. Sua conta e senha serão preservadas. Se houver um erro, nenhuma alteração será salva.</p><%= form_with url: restore_backup_path, class: 'stack' do |f| %><label class="check"><%= f.check_box :confirm, required: true %> Confirmo a substituição de todos os dados financeiros pelo backup.</label><%= f.submit 'Restaurar backup', class: 'button danger' %><% end %><div class="spaced"><%= button_to 'Cancelar', cancel_backup_path, method: :delete, class: 'button secondary' %></div></section>
